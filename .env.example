# Локальні Python-команди підключаються через опублікований порт PostgreSQL.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=laptops
DB_USER=myruich
DB_PASSWORD=

# Адреса PostgreSQL усередині Docker-мережі.
DOCKER_DB_HOST=postgres
DOCKER_DB_PORT=5432

# Публічний порт backend та налаштування Uvicorn у контейнері.
BACKEND_HOST_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Шляхи на хості; для локального Python відносні до кореня проєкту.
MODEL_DIR=./ml/models
FRONTEND_DIR=./frontend
LOG_DIR=./logs
DB_INIT_SQL_PATH=./db/init.sql
BACKEND_BUILD_CONTEXT=.
BACKEND_DOCKERFILE=backend/Dockerfile

# Відповідні шляхи всередині контейнерів.
DOCKER_MODEL_DIR=/app/ml/models
DOCKER_FRONTEND_DIR=/app/frontend
DOCKER_LOG_DIR=/app/logs
DOCKER_POSTGRES_DATA_DIR=/var/lib/postgresql/data
DOCKER_DB_INIT_SQL_PATH=/docker-entrypoint-initdb.d/init.sql
