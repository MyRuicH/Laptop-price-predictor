{
  "info": {
    "name": "Laptop Price Predictor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import this file into Postman and run the full collection in order. Edit collection variables, especially baseUrl. No authentication or database password is needed. Numeric/boolean body variables must remain valid JSON literals. Successful predictions append database records. lastPrediction and legacyNoOsPrediction are populated by tests. Frontend HTML files are currently empty. Server errors (500) and database outages require controlled fault injection and are not triggered by this collection."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "expectedHealthStatus",
      "value": "ok",
      "type": "string"
    },
    {
      "key": "company",
      "value": "Lenovo",
      "type": "string"
    },
    {
      "key": "type_name",
      "value": "Notebook",
      "type": "string"
    },
    {
      "key": "inches",
      "value": "15.6",
      "type": "string"
    },
    {
      "key": "screen_width",
      "value": "1920",
      "type": "string"
    },
    {
      "key": "screen_height",
      "value": "1080",
      "type": "string"
    },
    {
      "key": "is_ips",
      "value": "true",
      "type": "string"
    },
    {
      "key": "is_touchscreen",
      "value": "false",
      "type": "string"
    },
    {
      "key": "cpu_model",
      "value": "Core i5 7200U",
      "type": "string"
    },
    {
      "key": "cpu_ghz",
      "value": "2.5",
      "type": "string"
    },
    {
      "key": "ram_gb",
      "value": "8",
      "type": "string"
    },
    {
      "key": "storage_type",
      "value": "SSD",
      "type": "string"
    },
    {
      "key": "storage_gb",
      "value": "256",
      "type": "string"
    },
    {
      "key": "gpu_model",
      "value": "HD Graphics 620",
      "type": "string"
    },
    {
      "key": "opsys",
      "value": "Windows 10",
      "type": "string"
    },
    {
      "key": "weight",
      "value": "2.0",
      "type": "string"
    },
    {
      "key": "noOsValue",
      "value": "No OS",
      "type": "string"
    },
    {
      "key": "legacyOpsys",
