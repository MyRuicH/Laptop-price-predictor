  "item": [
    {
      "name": "01 Service and model",
      "item": [
        {
          "name": "Health: model and database",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Set expectedHealthStatus=degraded when intentionally checking a database outage."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const health = pm.response.json();",
                  "pm.test(\"Expected service health\", function () {",
                  "  pm.expect(health.status).to.equal(pm.variables.get(\"expectedHealthStatus\"));",
                  "  pm.expect(health.model_loaded).to.equal(true);",
                  "  pm.expect(health.db_ok).to.be.a(\"boolean\");",
                  "  if (health.status === \"ok\") pm.expect(health.db_ok).to.equal(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Options: dropdowns and No OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/options",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const options = pm.response.json();",
                  "pm.test(\"Form options are available\", function () {",
                  "  pm.expect(options.cpu_models).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(options.gpu_models).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(options.dropdowns.opsys).to.include(pm.variables.get(\"noOsValue\"));",
                  "  pm.expect(options.numeric_ranges.inches.min).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Model info: MAPE is a fraction",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/model-info",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const info = pm.response.json();",
                  "pm.test(\"Model metrics and interval source\", function () {",
                  "  pm.expect(info.n_features).to.be.a(\"number\").and.above(0);",
                  "  [\"rmse\", \"mae\", \"r2\", \"mape\"].forEach(k => pm.expect(info.test_metrics[k]).to.be.a(\"number\"));",
                  "  pm.expect(info.test_metrics.mape).to.be.at.least(0);",
                  "  pm.expect([\"quantiles\", \"mape_fallback\"]).to.include(info.interval_source);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 Successful predictions",
      "item": [
        {
          "name": "Predict: all fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/predict",
            "description": "Numbers and booleans use unquoted variables. Successful requests append a database history record.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{company}}\",\n  \"type_name\": \"{{type_name}}\",\n  \"inches\": {{inches}},\n  \"screen_width\": {{screen_width}},\n  \"screen_height\": {{screen_height}},\n  \"is_ips\": {{is_ips}},\n  \"is_touchscreen\": {{is_touchscreen}},\n  \"cpu_model\": \"{{cpu_model}}\",\n  \"cpu_ghz\": {{cpu_ghz}},\n  \"ram_gb\": {{ram_gb}},\n  \"storage_type\": \"{{storage_type}}\",\n  \"storage_gb\": {{storage_gb}},\n  \"gpu_model\": \"{{gpu_model}}\",\n  \"opsys\": \"{{opsys}}\",\n  \"weight\": {{weight}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const result = pm.response.json();",
                  "pm.test(\"Prediction shape and price range\", function () {",
                  "  pm.expect(result.predicted_price).to.be.a(\"number\").and.above(0);",
                  "  pm.expect(result.price_low).to.be.a(\"number\").and.at.most(result.predicted_price);",
                  "  pm.expect(result.price_high).to.be.a(\"number\").and.at.least(result.predicted_price);",
                  "  pm.expect(result.model_name).to.be.a(\"string\");",
                  "  pm.expect(result.warnings).to.be.an(\"array\");",
                  "});",
                  "pm.collectionVariables.set(\"lastPrediction\", result.predicted_price);"
                ]
              }
            }
          ],
          "response": []
        },
